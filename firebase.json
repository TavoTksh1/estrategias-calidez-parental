{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.*",
      "**/.*",
      "**/node_modules/**",
      "videos/**",
      "videos.json",
      "img/mockups/**",
      "**/*.md",
      "**/*.mp4",
      "PaletaColores.jpeg"
    ],
    "headers": [
      { "source": "**/*.@(js|css|html|json|svg)", "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ] },
      { "source": "**", "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ] }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
